# GIAM-SAT Server Configuration
# Copy to .env and fill in your values
#
# Database Backend
# Options: sqlite (default), postgres
GIAMSAT_DB_BACKEND=sqlite

# PostgreSQL (only if GIAMSAT_DB_BACKEND=postgres)
GIAMSAT_PG_HOST=127.0.0.1
GIAMSAT_PG_PORT=5432
GIAMSAT_PG_DBNAME=giamsat
GIAMSAT_PG_USER=postgres
GIAMSAT_PG_PASSWORD=your_password_here
GIAMSAT_PG_POOL_MIN=10
GIAMSAT_PG_POOL_MAX=50

# DeepSeek API Key (optional - AI Assistant & Auto-Monitor)
DEEPSEEK_API_KEY=

# Other AI providers (optional - AI Assistant)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Disable AI Assistant (set to 1 to disable)
GIAMSAT_DISABLE_AI=0

# Telegram Bot (optional - alert notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP Email (optional - email alerts)
GIAMSAT_SMTP_HOST=
GIAMSAT_SMTP_PORT=465
GIAMSAT_SMTP_USER=
GIAMSAT_SMTP_PASS=

# First-run Admin account (created only when no users exist yet).
# setup_config.ps1 asks for these interactively and writes them here.
# Leave empty -> server generates a RANDOM password and prints it once.
GIAMSAT_ADMIN_USER=admin
GIAMSAT_ADMIN_PASSWORD=

# Enrollment Secret (default below)
GIAMSAT_ENROLLMENT_SECRET=change-me-enroll-secret

# Agent Pre-Shared Key (required for TCP agent authentication on port 6666)
# NOTE: the agent also sends this PSK over HTTP (port 5000) for its polling
# endpoints (pending-commands, heartbeat, command-result, download, add-pending).
# HTTP is plaintext — for production, put the web server behind a TLS reverse
# proxy (Nginx/Caddy) so the PSK is not exposed on the wire.
GIAMSAT_AGENT_PSK=

# Flask session/JWT signing key (auto-generated if empty)
GIAMSAT_SECRET_KEY=

# Command signing key (HMAC-SHA256; shared with agents to sign/verify commands)
GIAMSAT_COMMAND_KEY=

# Cluster shared secret (HMAC for UDP cluster messages; fail-closed if unset)
GIAMSAT_CLUSTER_SECRET=

# Telegram SOC user IDs allowed to approve/deny alerts (comma-separated)
GIAMSAT_TELEGRAM_SOC_IDS=

# =============================================================================
# v5.0.3 (2026-08) — các biến MỚI / TÙY CHỌN
# =============================================================================

# Per-machine PSK (LOW-9): máy nào có entry bắt buộc dùng secret RIÊNG (thắng
# GIAMSAT_AGENT_PSK); máy không có entry vẫn dùng global PSK.
# Cách 1 — JSON inline:
#GIAMSAT_PER_MACHINE_PSK={"PC-001":"secret-rieng-pc-001"}
# Cách 2 — file JSON chứa map {"machine_id":"secret"}:
#GIAMSAT_PER_MACHINE_PSK_FILE=D:\giamsat\per_machine_psk.json
# ⚠️ Nhớ đặt đúng secret tương ứng trong agent_config.json của từng máy.

# Syslog UDP 514: giới hạn gói/giây mỗi nguồn (mặc định 200; chống UDP flood)
#GIAMSAT_SYSLOG_MAX_PPS=200

# NetFlow UDP: đổi cổng nghe nếu 2055 bị trùng (mặc định 2055)
#GIAMSAT_NETFLOW_PORT=2055

# API rate limit: số request tối đa / 60s / mỗi IP (mặc định 600)
#GIAMSAT_API_RATE_LIMIT=600

# GeoIP organization lookup (v5.0.4): Network/NetFlow hiển thị tổ chức của IP đích
# (kiểu whois). Chạy tools\setup_geolite2.ps1 để tải DB (dbip lite, miễn phí) vào
# server\data\. Chỉ cần set 2 biến này nếu muốn để DB ở chỗ khác:
#GIAMSAT_GEOIP_ASN_DB=D:\giamsat\server\data\dbip-asn-lite.mmdb
#GIAMSAT_GEOIP_CITY_DB=D:\giamsat\server\data\dbip-city-lite.mmdb


# Network Behavioral Alerts (v5.0.4): phát hiện C2 theo HÀNH VI từ NetFlow
# (NET-BEACON chu kỳ đều / NET-FIRST first-seen / NET-ODD giờ lạ) - không cần IP reputation.
#GIAMSAT_NET_ALERT_INTERVAL=60        # chu kỳ quét (s)
#GIAMSAT_NET_ALERT_WINDOW=1800        # cửa sổ quét (s)
#GIAMSAT_NET_BEACON_MIN_FLOWS=5       # số flow tối thiểu = beacon
#GIAMSAT_NET_FIRST_SEEN_DAYS=14       # ngày 'chưa từng thấy' cho NET-FIRST

# =============================================================================
# v5.0.4 (2026-09) — cổng / TLS / threat-intel / Net behavior bổ sung
# =============================================================================

# Cổng mặc định (chỉ đổi khi cần; agent phải cấu hình cùng cổng)
#GIAMSAT_WEB_PORT=5000
#GIAMSAT_TCP_PORT=6666

# Web HTTPS ngay trên cổng 5000 (chống lộ PSK/session khi chưa có reverse proxy).
# Server tự sinh cert self-signed. Agent phải bật server_tls=true + tin CA.
#GIAMSAT_WEB_TLS_ENABLED=false

# Syslog TCP :6514 (nâng cấp) — gửi log mạng qua TCP thay vì UDP. TLS tự động khi
# set đủ CERT+KEY (tạo bằng openssl; agent/server không cần thêm gì).
#GIAMSAT_SYSLOG_TCP_PORT=6514          # đặt 0 để tắt hẳn listener TCP
#GIAMSAT_SYSLOG_TLS_CERT=C:\giamsat\certs\syslog.crt
#GIAMSAT_SYSLOG_TLS_KEY=C:\giamsat\certs\syslog.key
#GIAMSAT_SYSLOG_MAX_WORKERS=8          # parser threads tối đa (chống self-DoS)

# Threat Intel (v5.0.4): file IOC local (ips/domains) + OTX enrichment.
# UI Threats > Watchlist > "Push vào intel file" ghi đè file này.
#GIAMSAT_INTEL_FILE=D:\giamsat\server\data\intel_local.json
#GIAMSAT_OTX_API_KEY=

# NET-* behavioral alert ngưỡng (đã có NET_ALERT_WINDOW/INTERVAL/MIN_FLOWS bên trên)
#GIAMSAT_NET_BEACON_MAX_CV=0.35        # jitter tối đa coi là beacon (0.0-1.0)
#GIAMSAT_NET_BEACON_MIN_SPAN=300       # span tối thiểu (s) để tính beacon

# Sigma rules auto-update (cần Git cài sẵn)
#GIAMSAT_SIGMA_AUTO=1

# Event worker pool (mặc định 8) / SSE payload tối đa
#GIAMSAT_EVENT_WORKERS=8
#GIAMSAT_SSE_MAX=200

# (Tùy chọn nâng cao — chạy khi dùng Redis / RabbitMQ / Elasticsearch)
#GIAMSAT_REDIS_HOST=
#GIAMSAT_REDIS_PORT=6379
#GIAMSAT_REDIS_PASSWORD=
#GIAMSAT_RABBITMQ_URL=
#GIAMSAT_RABBITMQ_EXCHANGE=giamsat

