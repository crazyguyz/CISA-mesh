<!--
  GIAM-SAT Sysmon Configuration v2.6.5
  Enables all key Event IDs for security monitoring:
    ID 1  - Process Create (full cmdline, hashes, parent, user)
    ID 3  - Network Connect (PID + IP + Port) ← Process-Network Association
    ID 7  - Image Load (DLL loaded into process)
    ID 8  - CreateRemoteThread (Process Injection!)
    ID 10 - Process Access (LSASS dumping detection)
    ID 11 - File Create (file creation monitoring)
    ID 12 - Registry Create/Delete
    ID 13 - Registry Set Value
    ID 14 - Registry Rename
    ID 22 - DNS Query (process + domain)
    ID 23/26 - File Delete (v4.13: ransomware mass-delete detection)
    ID 25 - Process Tampering (v4.13: ETW/AMSI patch detection)
    ID 255 - Config Change (v4.13: Sysmon rules tampering detection)
  
  v2.6.5: Added NetworkConnect exclusions to reduce noise:
    - Browser processes (chrome, edge, firefox, etc.)
    - Microsoft/Azure/CDN IP ranges
-->
<Sysmon schemaversion="4.90">
  <!-- v4.6.2 (SEC review B10): hashes on EID 1/11 so MISP hash-check, YARA hash
       and IOC sweep actually have data to work with -->
  <HashAlgorithms>MD5,SHA256</HashAlgorithms>
  <EventFiltering>
    <!-- Log everything by default (no exclude filters) -->
    <ProcessCreate onmatch="include"/>
    <FileCreateTime onmatch="include"/>
    <!-- v4.6.2 (SEC review A6): browser/IP excludes removed - they made C2 via
         Azure/Cloudflare VPS ranges (20.x/104.x/131.x) + headless-browser exfil
         100% invisible. Raw EID 3 must reach the server; noise filtering belongs
         server-side, not at the source. -->
    <NetworkConnect onmatch="include"/>
    <ProcessTerminate onmatch="include"/>
    <DriverLoad onmatch="include"/>
    <ImageLoad onmatch="include"/>
    <CreateRemoteThread onmatch="include"/>
    <RawAccessRead onmatch="include"/>
    <ProcessAccess onmatch="include"/>
    <FileCreate onmatch="include"/>
    <FileCreateStreamHash onmatch="include"/>
    <RegistryEvent onmatch="include"/>
    <WmiEvent onmatch="include"/>
    <DnsQuery onmatch="include"/>
    <PipeEvent onmatch="include"/>
    <FileDelete onmatch="include"/>
    <ProcessTampering onmatch="include"/>
    <ConfigChange onmatch="include"/>
  </EventFiltering>
</Sysmon>